+#[derive(Clone, Copy)]
+struct Round18byFullProbe {
+    completed: bool,
+    exact: bool,
+    clean: bool,
+    cycles: u64,
+    mismatches: u32,
+    mod4: [u32; 4],
+    first_mismatch: u32,
+    expected_bits: u32,
+    actual_bits: u32,
+}
+
+fn round18by_probe_full(
+    weight_virt: u64,
+    input: &[f32],
+    variant: u32,
+    control: &[f32],
+) -> Round18byFullProbe {
+    let mut candidate = alloc::vec![0.0f32; ROUND18BV_DIM_M];
+    let fault_before = GPU_FAULT_COUNT.load(Ordering::Relaxed);
+    let recovery_before = GPU_RECOVERY_COUNT.load(Ordering::Relaxed);
+    ROUND18BV_INSTALLED_VARIANT.store(u32::MAX, Ordering::Release);
+    let d = round18bv_dispatch_variant_once(variant, weight_virt, input, &mut candidate);
+    let restore = round18az_restore_l3_production();
+    let completed = d.outcome == GpuDispatchOutcome::Completed;
+    let clean = completed
+        && d.guard_clean
+        && d.l3_slm_exact
+        && restore
+        && GPU_FAULT_COUNT.load(Ordering::Relaxed) == fault_before
+        && GPU_RECOVERY_COUNT.load(Ordering::Relaxed) == recovery_before;
+
+    let mut mismatches = 0u32;
+    let mut mod4 = [0u32; 4];
+    let mut first = u32::MAX;
+    let mut expected = 0u32;
+    let mut actual = 0u32;
+    for row in 0..ROUND18BV_DIM_M {
+        let e = control[row].to_bits();
+        let a = candidate[row].to_bits();
+        if e != a {
+            mismatches += 1;
+            mod4[row & 3] += 1;
+            if first == u32::MAX {
+                first = row as u32;
+                expected = e;
+                actual = a;
+            }
+        }
+    }
+    Round18byFullProbe {
+        completed,
+        exact: clean && mismatches == 0,
+        clean,
+        cycles: d.cycles,
+        mismatches,
+        mod4,
+        first_mismatch: first,
+        expected_bits: expected,
+        actual_bits: actual,
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Round18byFootprintProbe {
+    completed: bool,
+    clean: bool,
+    cycles: u64,
+    observed_sentinel: u32,
+    observed_tile255: u32,
+    lane1_sentinel: u32,
+    lane2_tile255: u32,
+    slot_exact: u32,
+    ambiguous: bool,
+}
+
+fn round18by_probe_footprint(
+    weight_virt: u64,
+    input: &[f32],
+    variant: u32,
+) -> Round18byFootprintProbe {
+    let mut output = alloc::vec![0.0f32; ROUND18BV_DIM_M];
+    let fault_before = GPU_FAULT_COUNT.load(Ordering::Relaxed);
+    let recovery_before = GPU_RECOVERY_COUNT.load(Ordering::Relaxed);
+    ROUND18BV_INSTALLED_VARIANT.store(u32::MAX, Ordering::Release);
+    let d = round18bv_dispatch_variant_once(variant, weight_virt, input, &mut output);
+    let restore = round18az_restore_l3_production();
+    let completed = d.outcome == GpuDispatchOutcome::Completed;
+    let clean = completed
+        && d.guard_clean
+        && d.l3_slm_exact
+        && restore
+        && GPU_FAULT_COUNT.load(Ordering::Relaxed) == fault_before
+        && GPU_RECOVERY_COUNT.load(Ordering::Relaxed) == recovery_before;
+
+    let tile255 = input[255].to_bits();
+    let ambiguous = tile255 == ROUND18BY_SENTINEL;
+    let mut observed_sentinel = 0u32;
+    let mut observed_tile255 = 0u32;
+    let mut lane1_sentinel = 0u32;
+    let mut lane2_tile255 = 0u32;
+    let mut slot_exact = 0u32;
+    for slot in 0..ROUND18BY_FOOTPRINT_THREADS {
+        let base = slot * 4;
+        let observed = output[base].to_bits();
+        observed_sentinel += (observed == ROUND18BY_SENTINEL) as u32;
+        observed_tile255 += (observed == tile255) as u32;
+        lane1_sentinel += (output[base + 1].to_bits() == ROUND18BY_SENTINEL) as u32;
+        lane2_tile255 += (output[base + 2].to_bits() == tile255) as u32;
+        slot_exact += (output[base + 3].to_bits() == slot as u32) as u32;
+    }
+    Round18byFootprintProbe {
+        completed,
+        clean,
+        cycles: d.cycles,
+        observed_sentinel,
+        observed_tile255,
+        lane1_sentinel,
+        lane2_tile255,
+        slot_exact,
+        ambiguous,
+    }
+}
+
+fn round18by_stage0_causal(
+    weight_virt: u64,
+    input: &[f32],
+) -> bool {
+    let mut control = alloc::vec![0.0f32; ROUND18BV_DIM_M];
+    let b = q4k_run_timed_mode(
+        weight_virt as *const u8,
+        ROUND18BV_DIM_M as u32,
+        ROUND18BV_DIM_K as u32,
+        input,
+        &mut control,
+        4,
+        1,
+    );
+    if b.0 != GpuDispatchOutcome::Completed {
+        ROUND18BY_FAILURES.fetch_add(1, Ordering::Relaxed);
+        return false;
+    }
+
+    let unsafe_fp = round18by_probe_footprint(
+        weight_virt, input, ROUND18BY_VARIANT_FOOTPRINT_UNSAFE);
+    let exact_fp = round18by_probe_footprint(
+        weight_virt, input, ROUND18BY_VARIANT_FOOTPRINT_EXACT);
+    ROUND18BY_RUNS.fetch_add(2, Ordering::Relaxed);
+    ROUND18BY_BIT_CHECKS.fetch_add((ROUND18BY_FOOTPRINT_THREADS as u64) * 8, Ordering::Relaxed);
+
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-FOOTPRINT] mode=UNSAFE completed={} clean={} cycles={} threads={} observed_sentinel={} observed_tile255={} lane1_sentinel={} lane2_tile255={} slot_exact={} tile255=0x{:08x} sentinel=0x{:08x} ambiguous={}\n",
+        unsafe_fp.completed as u8, unsafe_fp.clean as u8, unsafe_fp.cycles,
+        ROUND18BY_FOOTPRINT_THREADS, unsafe_fp.observed_sentinel,
+        unsafe_fp.observed_tile255, unsafe_fp.lane1_sentinel,
+        unsafe_fp.lane2_tile255, unsafe_fp.slot_exact, input[255].to_bits(),
+        ROUND18BY_SENTINEL, unsafe_fp.ambiguous as u8));
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-FOOTPRINT] mode=EXACT completed={} clean={} cycles={} threads={} observed_sentinel={} observed_tile255={} lane1_sentinel={} lane2_tile255={} slot_exact={} tile255=0x{:08x} sentinel=0x{:08x} ambiguous={}\n",
+        exact_fp.completed as u8, exact_fp.clean as u8, exact_fp.cycles,
+        ROUND18BY_FOOTPRINT_THREADS, exact_fp.observed_sentinel,
+        exact_fp.observed_tile255, exact_fp.lane1_sentinel,
+        exact_fp.lane2_tile255, exact_fp.slot_exact, input[255].to_bits(),
+        ROUND18BY_SENTINEL, exact_fp.ambiguous as u8));
+
+    let footprint_signature = !unsafe_fp.ambiguous
+        && unsafe_fp.completed && unsafe_fp.clean
+        && exact_fp.completed && exact_fp.clean
+        && unsafe_fp.observed_sentinel == 0
+        && unsafe_fp.observed_tile255 == ROUND18BY_FOOTPRINT_THREADS as u32
+        && exact_fp.observed_sentinel == ROUND18BY_FOOTPRINT_THREADS as u32
+        && exact_fp.observed_tile255 == 0
+        && unsafe_fp.lane1_sentinel == ROUND18BY_FOOTPRINT_THREADS as u32
+        && exact_fp.lane1_sentinel == ROUND18BY_FOOTPRINT_THREADS as u32
+        && unsafe_fp.lane2_tile255 == ROUND18BY_FOOTPRINT_THREADS as u32
+        && exact_fp.lane2_tile255 == ROUND18BY_FOOTPRINT_THREADS as u32
+        && unsafe_fp.slot_exact == ROUND18BY_FOOTPRINT_THREADS as u32
+        && exact_fp.slot_exact == ROUND18BY_FOOTPRINT_THREADS as u32;
+
+    let unsafe_full = round18by_probe_full(
+        weight_virt, input, ROUND18BY_VARIANT_FULL_UNSAFE, &control);
+    let exact_full = round18by_probe_full(
+        weight_virt, input, ROUND18BY_VARIANT_FULL_EXACT, &control);
+    ROUND18BY_RUNS.fetch_add(2, Ordering::Relaxed);
+    ROUND18BY_BIT_CHECKS.fetch_add((ROUND18BV_DIM_M as u64) * 2, Ordering::Relaxed);
+
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-BITMAP] mode=UNSAFE completed={} clean={} exact={} cycles={} mismatches={} mod0={} mod1={} mod2={} mod3={} first={} expected=0x{:08x} actual=0x{:08x}\n",
+        unsafe_full.completed as u8, unsafe_full.clean as u8, unsafe_full.exact as u8,
+        unsafe_full.cycles, unsafe_full.mismatches, unsafe_full.mod4[0],
+        unsafe_full.mod4[1], unsafe_full.mod4[2], unsafe_full.mod4[3],
+        unsafe_full.first_mismatch, unsafe_full.expected_bits, unsafe_full.actual_bits));
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-BITMAP] mode=EXACT completed={} clean={} exact={} cycles={} mismatches={} mod0={} mod1={} mod2={} mod3={} first={} expected=0x{:08x} actual=0x{:08x}\n",
+        exact_full.completed as u8, exact_full.clean as u8, exact_full.exact as u8,
+        exact_full.cycles, exact_full.mismatches, exact_full.mod4[0],
+        exact_full.mod4[1], exact_full.mod4[2], exact_full.mod4[3],
+        exact_full.first_mismatch, exact_full.expected_bits, exact_full.actual_bits));
+
+    let bitmap_signature = unsafe_full.completed && unsafe_full.clean
+        && !unsafe_full.exact
+        && unsafe_full.mismatches == 2048
+        && unsafe_full.mod4[0] == 2048
+        && unsafe_full.mod4[1] == 0
+        && unsafe_full.mod4[2] == 0
+        && unsafe_full.mod4[3] == 0
+        && unsafe_full.first_mismatch == 0;
+    let fixed_signature = exact_full.completed && exact_full.clean
+        && exact_full.exact && exact_full.mismatches == 0;
+    let root_proven = footprint_signature && bitmap_signature && fixed_signature;
+    ROUND18BY_ROOT_PROVEN.store(root_proven as u32, Ordering::Release);
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-CAUSAL] footprint_signature={} bitmap_signature={} fixed_signature={} root_proven={} control_cycles={} unsafe_cycles={} exact_cycles={} repair=SIMD1_EXACT_RECONSTRUCTION legacy_helper_global_change=0 promoted=0\n",
+        footprint_signature as u8, bitmap_signature as u8, fixed_signature as u8,
+        root_proven as u8, b.1, unsafe_full.cycles, exact_full.cycles));
+    if !root_proven {
+        ROUND18BY_FAILURES.fetch_add(1, Ordering::Relaxed);
+    }
+    root_proven
+}
