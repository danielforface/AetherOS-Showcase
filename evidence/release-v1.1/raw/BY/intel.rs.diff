+fn round18by_run_pair(
+    weight_virt: u64,
+    input: &[f32],
+    candidate_first: bool,
+) -> Round18bwPairResult {
+    let saved = ROUND18BW_SELECTED_VARIANT.load(Ordering::Acquire);
+    ROUND18BW_SELECTED_VARIANT.store(ROUND18BY_VARIANT_FULL_EXACT, Ordering::Release);
+    let r = round18bw_run_pair(weight_virt, input, candidate_first);
+    ROUND18BW_SELECTED_VARIANT.store(saved, Ordering::Release);
+    r
+}
