+// ============================================================================
+// ROUND18BY: SLM RECONSTRUCTION WRITE-FOOTPRINT REPAIR
+// ============================================================================
+//
+// BX proved that delay/retirement/scoreboard manipulations do not repair the
+// deterministic row-0 failure.  Source audit then found an architectural write
+// footprint bug in the historical SLM reconstruction helper: emit_mov_grf_scalar
+// is a SIMD8 broadcast.  With dst_sub=1/2/3 it wraps into the following GRF.
+// Internal wraps are overwritten by subsequent reconstruction writes; the last
+// high-half write targets r109.3 and escapes into r110.0..2.  r110.0 is the
+// live ROTATE4 accumulator, so every K tile replaces row0's partial sum with
+// tile[255] before row0 arithmetic.
+//
+// The canonical helper above is repaired locally with exact SIMD1 UD copies.
+// The global broadcast helper is intentionally NOT changed because SEND header
+// construction and other call sites depend on its broadcast semantics.
+//
+// Stage 0 is causal, not merely a corrected A/B:
+//   * footprint UNSAFE: r110 sentinel must be destroyed and become tile[255]
+//   * footprint EXACT:  r110 sentinel must survive reconstruction
+//   * full UNSAFE:      mismatch bitmap must be exactly row%4==0 (2048 rows)
+//   * full EXACT:       all 8192 rows must match FACTORED bit-for-bit
+// Only that complete signature sets root_proven and unlocks Requests 2..4.
+
+const ROUND18BY_VARIANT_FOOTPRINT_UNSAFE: u32 = 12;
+const ROUND18BY_VARIANT_FOOTPRINT_EXACT: u32 = 13;
+const ROUND18BY_VARIANT_FULL_UNSAFE: u32 = 14;
+const ROUND18BY_VARIANT_FULL_EXACT: u32 = 15;
+const ROUND18BY_SENTINEL: u32 = 0xA18B_18B1;
+const ROUND18BY_FOOTPRINT_THREADS: usize =
+    (ROUND18BV_GROUPS as usize) * (ROUND18BV_THREADS_PER_GROUP as usize);
+
+static ROUND18BY_QUALIFIED_MASK: AtomicU32 = AtomicU32::new(0);
+static ROUND18BY_ROOT_PROVEN: AtomicU32 = AtomicU32::new(0);
+static ROUND18BY_RUNS: AtomicU32 = AtomicU32::new(0);
+static ROUND18BY_FAILURES: AtomicU32 = AtomicU32::new(0);
+static ROUND18BY_BIT_CHECKS: AtomicU64 = AtomicU64::new(0);
+static ROUND18BY_PERF_1P10: AtomicU32 = AtomicU32::new(0);
+static ROUND18BY_ARCH_1P50: AtomicU32 = AtomicU32::new(0);
+
+/// Frozen pre-BY reconstruction used only by the stage-0 causal controls.
+/// Do not use this helper in a repaired candidate.
+fn round18by_emit_slm_tile_to_input_grfs_unsafe_legacy(asm: &mut Gen9Assembler) {
+    for segment in 0..8u32 {
+        asm.emit_mov_imm32(43, segment * 128);
+        for chunk in 0..4u32 {
+            round18ax_emit_slm_addresses(asm, 24, 43, chunk);
+            asm.emit_send_read_slm_simd8_ay(32, 24, true);
+
+            let input_pair = segment * 8 + chunk * 2;
+            let low = 46 + input_pair;
+            let high = low + 1;
+            for lane in 0..4u32 {
+                asm.emit_mov_grf_scalar(low, lane, 32, lane);
+            }
+            for lane in 0..4u32 {
+                asm.emit_mov_grf_scalar(high, lane, 32, lane + 4);
+            }
+        }
+    }
+}
+
+fn round18by_emit_shared_tile_publish(asm: &mut Gen9Assembler) {
+    // Same qualified cooperative activation producer as BU/BX.
+    asm.emit_shl_ud_imm(43, 39, 3);
+    asm.emit_add_ud_scalar(43, 0, 14, 0, 43, 0);
+    asm.emit_mov_grf_ud(2, 0);
+    asm.emit_mov_grf_scalar(2, 2, 43, 0);
+    asm.emit_send_read_oword_igc_parity(10, 16, 2, 1, 8, 4, true, true);
+    for grf in 16..20u32 {
+        asm.emit_mov_grf_ud(grf, grf);
+    }
+    asm.emit_shl_ud_imm(43, 39, 7);
+    for chunk in 0..4u32 {
+        round18ax_emit_slm_addresses(asm, 24, 43, chunk);
+        asm.emit_mov_grf_ud(25, 16 + chunk);
+        asm.emit_send_write_slm_simd8_ay(24, true);
+    }
+    // Keep BW's isolated fence destination for both controls and repaired path;
+    // BW already proved that r30->r126 alone does not affect correctness.
+    round18bw_emit_regular_barrier_isolated(asm, false);
+}
+
+fn build_round18by_reconstruction_footprint_kernel(
+    exact: bool,
+) -> alloc::vec::Vec<u32> {
+    let mut asm = Gen9Assembler::new();
+    round18bv_emit_global_row_and_local(&mut asm);
+    asm.emit_mov_imm32(14, 0); // first/only 1 KiB activation tile
+    asm.emit_mov_imm32_scalar(110, 0, ROUND18BY_SENTINEL);
+
+    round18by_emit_shared_tile_publish(&mut asm);
+    if exact {
+        round18be_emit_slm_tile_to_input_grfs(&mut asm);
+    } else {
+        round18by_emit_slm_tile_to_input_grfs_unsafe_legacy(&mut asm);
+    }
+
+    // One OWord per hardware thread.  CPU checks raw bits:
+    //   lane0 = observed r110.0 after reconstruction
+    //   lane1 = sentinel constant
+    //   lane2 = reconstructed tile[255] = r109.3 (four-DWord OWord layout)
+    //   lane3 = dense thread slot (group*8+local)
+    asm.emit_mov_imm32(124, 0);
+    asm.emit_mov_grf_ud_scalar_exact(124, 0, 110, 0);
+    asm.emit_mov_imm32_scalar(124, 1, ROUND18BY_SENTINEL);
+    asm.emit_mov_grf_ud_scalar_exact(124, 2, 109, 3);
+    round18bv_emit_dense_slot(&mut asm, 42);
+    asm.emit_mov_grf_ud_scalar_exact(124, 3, 42, 0);
+    round18bv_emit_dense_write_and_drain(&mut asm, 42, 124);
+    asm.emit_thread_end();
+    asm.code
+}
+
+fn build_round18by_slm_rotate4_kernel(
+    exact: bool,
+) -> alloc::vec::Vec<u32> {
+    let mut asm = Gen9Assembler::new();
+    round18bv_emit_global_row_and_local(&mut asm);
+
+    asm.emit_mov_imm32(2, Q4K_CONTROL_OWORD);
+    asm.emit_send_read_dc0(111, 2, 3, 1);
+    asm.emit_mov_grf_f32(111, 111);
+    asm.emit_mov_grf_scalar(117, 0, 111, 0);
+    asm.emit_mov_imm32(14, 0);
+    asm.emit_mov_imm32(45, 0);
+    asm.emit_clear_flags(15);
+
+    asm.emit_mov_f32_imm(110, 0);
+    asm.emit_mov_f32_imm(120, 0);
+    asm.emit_mov_f32_imm(121, 0);
+    asm.emit_mov_f32_imm(122, 0);
+
+    let block_loop_top = asm.instruction_count();
+    round18by_emit_shared_tile_publish(&mut asm);
+    if exact {
+        round18be_emit_slm_tile_to_input_grfs(&mut asm);
+    } else {
+        round18by_emit_slm_tile_to_input_grfs_unsafe_legacy(&mut asm);
+    }
+
+    asm.emit_mov_grf_scalar(41, 0, 40, 0);
+    asm.emit_mov_imm32(42, 4);
+    let row_loop_top = asm.instruction_count();
+
+    round18br_issue_row_weight_reads(&mut asm, 41, 15, 24, 13);
+    round18br_wait_row_metadata(&mut asm, 15);
+    round18ar_emit_row_arithmetic(&mut asm, 110, 15, 24);
+    round18bt_rotate_live_accumulators(&mut asm);
+
+    asm.emit_add_ud_imm(41, 41, 1);
+    asm.emit_add_ud_imm_condmod_nz(42, 42, (-1i32) as u32);
+    let row_loop_len = asm.instruction_count() - row_loop_top;
+    asm.emit_jmpi_f0(-(row_loop_len as i32));
+
+    round18bw_emit_regular_barrier_isolated(&mut asm, false);
+    asm.emit_add_ud_imm(14, 14, 64);
+    asm.emit_add_ud_imm(45, 45, 9);
+    asm.emit_add_ud_imm_condmod_nz(117, 117, (-1i32) as u32);
+    let block_loop_len = asm.instruction_count() - block_loop_top;
+    asm.emit_jmpi_f0(-(block_loop_len as i32));
+
+    asm.emit_mov_imm32(124, 0);
+    asm.emit_mov_grf_ud_scalar_exact(124, 0, 110, 0);
+    asm.emit_mov_grf_ud_scalar_exact(124, 1, 120, 0);
+    asm.emit_mov_grf_ud_scalar_exact(124, 2, 121, 0);
+    asm.emit_mov_grf_ud_scalar_exact(124, 3, 122, 0);
+    round18bv_emit_dense_slot(&mut asm, 42);
+    round18bv_emit_dense_write_and_drain(&mut asm, 42, 124);
+    asm.emit_thread_end();
+    asm.code
+}
