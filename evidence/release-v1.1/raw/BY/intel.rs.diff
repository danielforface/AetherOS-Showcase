+
+fn round18by_next(mask: u32) -> &'static str {
+    if ROUND18BY_ROOT_PROVEN.load(Ordering::Acquire) == 0 {
+        "COOPERATIVE_Q4_RECONSTRUCTION_FOOTPRINT_DEEP_TRACE"
+    } else if mask != 0xF {
+        "COOPERATIVE_Q4_RECONSTRUCTION_REPAIR_QUALIFICATION"
+    } else if ROUND18BY_ARCH_1P50.load(Ordering::Acquire) != 0 {
+        "COOPERATIVE_Q4_EXECUTION_PACK_AND_OCCUPANCY"
+    } else {
+        "COOPERATIVE_Q4_EXECUTION_PACK_REQUIRED"
+    }
+}
+
+fn round18by_summary(request_id: u32) -> u32 {
+    let mask = ROUND18BY_QUALIFIED_MASK.load(Ordering::Acquire);
+    let perf = ROUND18BY_PERF_1P10.load(Ordering::Acquire);
+    let arch = ROUND18BY_ARCH_1P50.load(Ordering::Acquire);
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-SUM] request={} mask=0x{:x} root_proven={} runs={} failures={} bit_checks={} perf_1p10={} architecture_1p50={} production=DUAL_WALKER_FLUSH promoted=0\n",
+        request_id, mask, ROUND18BY_ROOT_PROVEN.load(Ordering::Acquire),
+        ROUND18BY_RUNS.load(Ordering::Relaxed), ROUND18BY_FAILURES.load(Ordering::Relaxed),
+        ROUND18BY_BIT_CHECKS.load(Ordering::Relaxed), perf, arch));
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-STAGE] request={} root_proven={} correctness_mask=0x{:x} perf_1p10={} architecture_1p50={} power_qualified=0 promoted=0 next={}\n",
+        request_id, ROUND18BY_ROOT_PROVEN.load(Ordering::Acquire), mask, perf, arch,
+        round18by_next(mask)));
+    mask
+}
+
+pub fn run_round18by_cooperative_q4_slm_reconstruction_repair(
+    request_id: u32,
+) -> u32 {
+    if request_id == 0 || request_id > 4 {
+        return ROUND18BY_QUALIFIED_MASK.load(Ordering::Acquire);
+    }
+    let Some(capture) = ROUND18BM_CAPTURE.lock().clone() else {
+        crate::serial::print_args(core::format_args!(
+            "[Q4K-BY-LAB] request={} capture=0 skipped=1\n", request_id));
+        return round18by_summary(request_id);
+    };
+    if capture.input.len() < ROUND18BV_DIM_K
+        || capture.gate_weight_virt == 0
+        || capture.up_weight_virt == 0
+        || capture.gate_weight_virt == capture.up_weight_virt
+    {
+        ROUND18BY_FAILURES.fetch_add(1, Ordering::Relaxed);
+        return round18by_summary(request_id);
+    }
+
+    let stage = request_id - 1;
+    let required = (1u32 << stage).wrapping_sub(1);
+    let before = ROUND18BY_QUALIFIED_MASK.load(Ordering::Acquire);
+    if (before & required) != required {
+        crate::serial::print_args(core::format_args!(
+            "[Q4K-BY-LAB] request={} stage={} mode={} skipped=1 required=0x{:x} mask=0x{:x}\n",
+            request_id, stage, round18by_mode(stage), required, before));
+        return round18by_summary(request_id);
+    }
+
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-LAB] request={} stage={} mode={} shape=8192x2048 groups=256 threads_per_group=8 repair=SIMD1_EXACT_RECONSTRUCTION production_unchanged=1\n",
+        request_id, stage, round18by_mode(stage)));
+
+    if stage == 0 {
+        if round18by_stage0_causal(capture.gate_weight_virt, &capture.input) {
+            ROUND18BY_QUALIFIED_MASK.fetch_or(1, Ordering::AcqRel);
+        }
+        return round18by_summary(request_id);
+    }
+
+    let target = round18by_target(stage);
+    let mut b = alloc::vec::Vec::<u64>::with_capacity(target as usize);
+    let mut c = alloc::vec::Vec::<u64>::with_capacity(target as usize);
+    let mut b_bc = alloc::vec::Vec::<u64>::new();
+    let mut c_bc = alloc::vec::Vec::<u64>::new();
+    let mut b_cb = alloc::vec::Vec::<u64>::new();
+    let mut c_cb = alloc::vec::Vec::<u64>::new();
+    let mut exact_runs = 0u32;
+    let mut completed_runs = 0u32;
+    let mut all_clean = true;
+    let mut first = u32::MAX;
+    let mut expected = 0u32;
+    let mut actual = 0u32;
+
+    for run in 0..target {
+        let use_up = ((run / 2) & 1) != 0;
+        let weight_virt = if use_up { capture.up_weight_virt } else { capture.gate_weight_virt };
+        let pattern = if stage < 2 { 0 } else { run & 7 };
+        let input = round18bu_input_pattern(&capture.input, pattern);
+        let candidate_first = (run & 1) != 0;
+        let r = round18by_run_pair(weight_virt, &input, candidate_first);
+        ROUND18BY_RUNS.fetch_add(1, Ordering::Relaxed);
+        ROUND18BY_BIT_CHECKS.fetch_add(ROUND18BV_DIM_M as u64, Ordering::Relaxed);
+        completed_runs += r.completed as u32;
+        exact_runs += r.exact as u32;
+        all_clean &= r.clean;
+        if r.first_mismatch != u32::MAX && first == u32::MAX {
+            first = r.first_mismatch;
+            expected = r.expected_bits;
+            actual = r.actual_bits;
+        }
+        if r.completed {
+            b.push(r.control_cycles); c.push(r.candidate_cycles);
+            if candidate_first {
+                b_cb.push(r.control_cycles); c_cb.push(r.candidate_cycles);
+            } else {
+                b_bc.push(r.control_cycles); c_bc.push(r.candidate_cycles);
+            }
+        }
+        crate::serial::print_args(core::format_args!(
+            "[Q4K-BY-CASE] req={} stage={} run={} matrix={} pattern={} order={} completed={} exact={} clean={} b_cycles={} c_cycles={} mismatch={} expected=0x{:08x} actual=0x{:08x}\n",
+            request_id, stage, run, if use_up { "UP" } else { "GATE" }, pattern,
+            if candidate_first { "C_B" } else { "B_C" }, r.completed as u8,
+            r.exact as u8, r.clean as u8, r.control_cycles, r.candidate_cycles,
+            r.first_mismatch, r.expected_bits, r.actual_bits));
+        if !r.exact { break; }
+    }
+
+    let stats_valid = b.len() == target as usize && c.len() == target as usize
+        && !b_bc.is_empty() && !b_cb.is_empty();
+    let mut bm=b.clone(); let mut cm=c.clone();
+    let mut bt=b.clone(); let mut ct=c.clone();
+    let mut bp=b.clone(); let mut cp=c.clone();
+    let mut bbc=b_bc.clone(); let mut cbc=c_bc.clone();
+    let mut bcb=b_cb.clone(); let mut ccb=c_cb.clone();
+    let b_med=if stats_valid { round18bg_median(&mut bm) } else {0};
+    let c_med=if stats_valid { round18bg_median(&mut cm) } else {0};
+    let b_trim=if stats_valid { round18bg_trimmed_mean(&mut bt) } else {0};
+    let c_trim=if stats_valid { round18bg_trimmed_mean(&mut ct) } else {0};
+    let b_p90=if stats_valid { round18bg_p90(&mut bp) } else {0};
+    let c_p90=if stats_valid { round18bg_p90(&mut cp) } else {0};
+    let b_bc_med=if stats_valid { round18bg_median(&mut bbc) } else {0};
+    let c_bc_med=if stats_valid { round18bg_median(&mut cbc) } else {0};
+    let b_cb_med=if stats_valid { round18bg_median(&mut bcb) } else {0};
+    let c_cb_med=if stats_valid { round18bg_median(&mut ccb) } else {0};
+    let ratio_med=round18bg_ratio(b_med,c_med);
+    let ratio_trim=round18bg_ratio(b_trim,c_trim);
+    let ratio_p90=round18bg_ratio(b_p90,c_p90);
+    let ratio_bc=round18bg_ratio(b_bc_med,c_bc_med);
+    let ratio_cb=round18bg_ratio(b_cb_med,c_cb_med);
+    let order_delta=round18bg_abs_diff(ratio_bc,ratio_cb);
+    let correctness=completed_runs==target && exact_runs==target && all_clean && stats_valid;
+    let perf=correctness && ratio_med>=11_000 && ratio_trim>=11_000
+        && ratio_p90>=10_000 && ratio_bc>=10_000 && ratio_cb>=10_000
+        && order_delta<=500;
+    let arch=correctness && ratio_med>=15_000 && ratio_trim>=15_000
+        && ratio_p90>=10_000 && ratio_bc>=10_000 && ratio_cb>=10_000
+        && order_delta<=500;
+    if correctness {
+        ROUND18BY_QUALIFIED_MASK.fetch_or(1 << stage, Ordering::AcqRel);
+    } else {
+        ROUND18BY_FAILURES.fetch_add(1, Ordering::Relaxed);
+    }
+    if stage == 3 {
+        ROUND18BY_PERF_1P10.store(perf as u32, Ordering::Release);
+        ROUND18BY_ARCH_1P50.store(arch as u32, Ordering::Release);
+    }
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-DIST] request={} stage={} exact_runs={} target={} b_med={} c_med={} ratio_med={} b_trim={} c_trim={} ratio_trim={} ratio_p90={} ratio_bc={} ratio_cb={} order_delta={} stats_valid={}\n",
+        request_id, stage, exact_runs, target, b_med, c_med, ratio_med, b_trim,
+        c_trim, ratio_trim, ratio_p90, ratio_bc, ratio_cb, order_delta,
+        stats_valid as u8));
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-CERT] request={} stage={} attempted={} completed={} exact_runs={} target={} clean={} full_rows=8192 bit_checks={} first_mismatch={} expected=0x{:08x} actual=0x{:08x} result={}\n",
+        request_id, stage, target, completed_runs, exact_runs, target,
+        all_clean as u8, (target as u64)*(ROUND18BV_DIM_M as u64), first,
+        expected, actual, if correctness { "PASS" } else { "FAIL" }));
+    crate::serial::print_args(core::format_args!(
+        "[Q4K-BY-GATE] request={} correctness={} median_1p10={} trimmed_1p10={} median_1p50={} trimmed_1p50={} p90_nonregression={} bc_nonregression={} cb_nonregression={} order_gate={} perf_carry={} architecture_1p50={} power_qualified=0 promoted=0\n",
+        request_id, correctness as u8, (ratio_med>=11_000) as u8,
+        (ratio_trim>=11_000) as u8, (ratio_med>=15_000) as u8,
+        (ratio_trim>=15_000) as u8, (ratio_p90>=10_000) as u8,
+        (ratio_bc>=10_000) as u8, (ratio_cb>=10_000) as u8,
+        (order_delta<=500) as u8, if stage==3 { perf as u8 } else {0},
+        if stage==3 { arch as u8 } else {0}));
+    round18by_summary(request_id)
+}
